{
  "model_name": "openai/whisper-small",
  "training": {
    "num_epochs": 10,
    "batch_size": 8,
    "learning_rate": 1e-5,
    "weight_decay": 0.01,
    "warmup_steps": 500,
    "max_steps": 4000,
    "gradient_accumulation_steps": 2,
    "freeze_encoder": true,
    "gradient_checkpointing": true,
    "fp16": true,
    "evaluation_strategy": "steps",
    "eval_steps": 500,
    "save_strategy": "steps",
    "save_steps": 500,
    "logging_steps": 50,
    "save_total_limit": 3,
    "load_best_model_at_end": true,
    "metric_for_best_model": "wer",
    "greater_is_better": false
  },
  "data": {
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "normalize_audio": true,
    "sample_rate": 16000,
    "max_duration": 30
  },
  "preprocessing": {
    "normalize_text": true,
    "augmentation": {
      "enabled": true,
      "noise_level": 0.005,
      "pitch_shift_range": 2,
      "speed_range": 0.2,
      "num_augmentations": 3
    }
  },
  "generation": {
    "language": "en",
    "task": "transcribe",
    "max_length": 225,
    "num_beams": 5,
    "temperature": 0.0
  }
}
