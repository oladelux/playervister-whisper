{
  "model_name": "openai/whisper-large-v2",
  "training": {
    "num_epochs": 30,
    "batch_size": 4,
    "learning_rate": 5e-6,
    "weight_decay": 0.01,
    "warmup_steps": 100,
    "max_steps": -1,
    "gradient_accumulation_steps": 4,
    "freeze_encoder": true,
    "gradient_checkpointing": true,
    "fp16": true,
    "evaluation_strategy": "steps",
    "eval_steps": 50,
    "save_strategy": "steps",
    "save_steps": 50,
    "logging_steps": 10,
    "save_total_limit": 3,
    "load_best_model_at_end": true,
    "metric_for_best_model": "wer",
    "greater_is_better": false,
    "label_smoothing": 0.1,
    "group_by_length": true,
    "num_workers": 4,
    "early_stopping_patience": 10,
    "early_stopping_threshold": 0.001
  },
  "data": {
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "normalize_audio": true,
    "sample_rate": 16000,
    "max_duration": 30,
    "augmentation": {
      "enabled": true,
      "noise_level": 0.005,
      "pitch_shift_range": 1.5,
      "speed_range": 0.15,
      "num_augmentations": 5
    }
  },
  "preprocessing": {
    "normalize_text": true,
    "text_cleaning": {
      "remove_special_characters": false,
      "lowercase": false,
      "standardize_punctuation": true
    }
  },
  "generation": {
    "language": "en",
    "task": "transcribe",
    "max_length": 225,
    "num_beams": 5,
    "temperature": 0.0
  },
  "use_wandb": false,
  "wandb_project": "football-whisper",
  "wandb_run_name": "football-whisper-large-v2",
  "push_to_hub": false
}
